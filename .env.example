# ── Required ──────────────────────────────────────────────────────────────────
# Login credentials
LOGIN_USERNAME=admin
# Generate hash: htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
# Or in Java: new BCryptPasswordEncoder().encode("yourpassword")
LOGIN_PASSWORD_HASH=<your password>

# LLM provider API key (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=<your API key>

# ── Optional (with defaults) ───────────────────────────────────────────────
# Ollama (default) — use 127.0.0.1, NOT localhost (Docker Desktop hijacks localhost → 172.17.0.2)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2
# Cloud alternative (uncomment and set OPENAI_API_KEY):
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# IBM Watsonx (leave empty if not using Watsonx)
WATSONX_PROJECT_ID=

# Storage
DATA_DIR=data
REPORT_OUTPUT_DIR=reports

# Server
FLASK_PORT=8080
PERMANENT_SESSION_LIFETIME=3600
SYNC_INTERVAL_SECONDS=30

# Logging
LOG_LEVEL=INFO

# ── IBM Box sync (optional) ────────────────────────────────────────────────────
# Set BOX_ENABLED=true and fill in credentials to sync the master Excel file to
# IBM Box after every successful Add/Delete Vacation operation.
# Leave BOX_ENABLED=false (or unset) to disable — no credentials are required.
BOX_ENABLED=false
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# Target folder ID in IBM Box (the numeric ID from the Box URL)
BOX_FOLDER_ID=
# JWT auth — leave empty if using Client Credentials Grant (CCG) instead
BOX_JWT_PRIVATE_KEY=
BOX_JWT_PRIVATE_KEY_PASSPHRASE=
BOX_JWT_PUBLIC_KEY_ID=
# Retry back-off base interval in seconds (default: 60)
BOX_RETRY_BACKOFF_SECONDS=60
